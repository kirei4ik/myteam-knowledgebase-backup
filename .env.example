# MyTeam
MYTEAM_BASE_URL=https://your-team.ismyteam.ru
MYTEAM_EMAIL=
MYTEAM_PASSWORD=

# Storage
STORAGE_BACKEND=local

# Local
LOCAL_BACKUP_DIR=./backups

# Work
WORK_DIR=/tmp/myteam-kb-backup

# Backup
CREATE_SNAPSHOT=true
SNAPSHOT_FORMAT=zip
SNAPSHOT_RETENTION_DAYS=30
# Сколько последних снапшотов хранить (0 — не хранить архивов)
SNAPSHOT_RETENTION_COUNT=7
# Минимальный интервал между снапшотами (часы и/или минуты, 0 — всегда)
SNAPSHOT_MIN_INTERVAL_HOURS=24
SNAPSHOT_MIN_INTERVAL_MINUTES=0
FAIL_ON_ASSET_ERROR=true
# Маскировать логины/пароли и email в выгружаемом контенте (.md/.html/.json)
REDACT=true

# Масштабирование
# Сколько статей обрабатывать параллельно (воркеры)
BACKUP_CONCURRENCY=8
# Ретраи сетевых запросов (# попыток и начальная задержка backoff, сек)
RETRY_COUNT=3
RETRY_BACKOFF=0.5

# GitHub
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_BACKUP_PATH=knowledge-base
GITHUB_COMMIT_AUTHOR_NAME=MyTeam Backup
GITHUB_COMMIT_AUTHOR_EMAIL=

# S3
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_PREFIX=myteam-kb
S3_VERIFY_SSL=true